# Base de datos (Supabase PostgreSQL)
DB_PASSWORD=tu_password_de_supabase

# Supabase Storage (CVs)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_service_role_key_de_supabase

# IA (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-tu_api_key

# Correos (Resend)
RESEND_API_KEY=re_tu_api_key
RESEND_FROM_EMAIL=AquaChile Selección <onboarding@resend.dev>

# CORS en producción (URL del frontend desplegado, sin barra final)
FRONTEND_URL=https://tu-frontend.vercel.app

# Puerto (Railway lo asigna automáticamente)
PORT=8080